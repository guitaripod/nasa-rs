# wrangler.toml.example — template for self-hosting the nasa-rs worker.
#
# Do not put your real IDs here. Run ./scripts/setup-worker.sh, which copies this
# file to wrangler.toml (gitignored) and fills in the KV namespace IDs it creates.
# Then add your secret and deploy:
#   wrangler secret put NASA_API_KEY    # free key at https://api.nasa.gov
#   wrangler deploy

name = "nasa-api-worker"
main = "build/worker/shim.mjs"
compatibility_date = "2024-01-01"
workers_dev = true

[build]
command = "bash scripts/build-worker.sh"

# Pre-warm the JWST catalog daily so its ~50s rebuild never lands on a user request.
[triggers]
crons = ["0 6 * * *"]

[vars]
ENVIRONMENT = "production"

[observability]
enabled = true

[observability.logs]
enabled = true

[[kv_namespaces]]
binding = "NASA_CACHE"
id = "__NASA_CACHE_ID__"

[[kv_namespaces]]
binding = "RATE_LIMIT"
id = "__RATE_LIMIT_ID__"

# The /api/jwst handler calls the jwst-provider worker. A direct fetch to another *.workers.dev
# from a Worker is blocked (Cloudflare error 1042), so a service binding is required. Self-hosters
# without a jwst-provider can drop this and the /api/jwst route.
[[services]]
binding = "JWST_PROVIDER"
service = "jwst-provider"

[env.production]
vars = { ENVIRONMENT = "production" }

[env.development]
vars = { ENVIRONMENT = "development" }

[env.staging]
vars = { ENVIRONMENT = "staging" }
